{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maestro:reviewer-stage-result:2.4",
  "title": "Reviewer Stage Result v2.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "case_id",
    "level",
    "binding",
    "evidence_digest",
    "reviewer",
    "verdict",
    "confidence",
    "findings",
    "risk_signal",
    "escalation",
    "output_safety",
    "result_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "task_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "L1",
        "L2",
        "ADVERSARIAL"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "reviewed_head_sha"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "reviewed_head_sha": {
          "type": "string"
        }
      }
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "model",
        "prompt_digest",
        "skill_digest",
        "policy_digest",
        "standards_digest",
        "independent_context"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "version"
          ],
          "properties": {
            "family": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "prompt_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "skill_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "standards_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independent_context": {
          "type": "boolean"
        },
        "worker_command_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FINDINGS",
        "BLOCKED"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "axis",
          "severity",
          "confidence",
          "certainty",
          "path",
          "claim",
          "evidence",
          "impact",
          "recommendation",
          "preexisting",
          "activated_or_worsened"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "axis": {
            "enum": [
              "correctness_security",
              "standards",
              "spec",
              "test_integrity",
              "supply_chain_compatibility",
              "risk"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "certainty": {
            "enum": [
              "confirmed",
              "likely",
              "judgment"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "preexisting": {
            "type": "boolean"
          },
          "activated_or_worsened": {
            "type": "boolean"
          },
          "failure_family": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "maxItems": 100
    },
    "risk_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reversibility",
        "blast_radius",
        "data_sensitivity",
        "security_surface",
        "availability_criticality"
      ],
      "properties": {
        "reversibility": {
          "enum": [
            "EASY",
            "MODERATE",
            "HARD"
          ]
        },
        "blast_radius": {
          "enum": [
            "LOCAL",
            "SERVICE",
            "MULTI_SERVICE",
            "EXTERNAL"
          ]
        },
        "data_sensitivity": {
          "enum": [
            "NONE",
            "INTERNAL",
            "PII",
            "SECRET"
          ]
        },
        "security_surface": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "availability_criticality": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "target",
        "reasons",
        "novel_failure_family"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "target": {
          "enum": [
            "NONE",
            "L2",
            "ADVERSARIAL",
            "HUMAN"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "novel_failure_family": {
          "type": "boolean"
        }
      }
    },
    "output_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sanitized",
        "external_urls_present",
        "markdown_images_present",
        "mentions_present",
        "secret_scan_passed"
      ],
      "properties": {
        "sanitized": {
          "type": "boolean"
        },
        "external_urls_present": {
          "type": "boolean"
        },
        "markdown_images_present": {
          "type": "boolean"
        },
        "mentions_present": {
          "type": "boolean"
        },
        "secret_scan_passed": {
          "type": "boolean"
        }
      }
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
