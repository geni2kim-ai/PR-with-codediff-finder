{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maestro:review-budget:2.7",
  "title": "Review Budget v2.7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "case_id",
    "authority_effect",
    "attempt_index",
    "max_automated_attempts",
    "same_material_finding_repeat_limit",
    "executed_agent_stages",
    "reused_agent_stages",
    "per_stage_timeout_seconds",
    "current_attempt_worker_timeout_budget_seconds",
    "campaign_worker_invocation_ceiling",
    "campaign_worker_invocations_used",
    "campaign_worker_timeout_ceiling_seconds",
    "current_material_finding_keys",
    "repeated_material_finding_keys",
    "automated_remediation_retry_allowed",
    "stop_reason",
    "budget_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "2.7"
    },
    "kind": {
      "const": "review-budget"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "ESCALATION_ONLY"
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 1
    },
    "max_automated_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "same_material_finding_repeat_limit": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5
    },
    "executed_agent_stages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "per_stage_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "current_attempt_worker_timeout_budget_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "campaign_worker_invocation_ceiling": {
      "type": "integer",
      "minimum": 1
    },
    "campaign_worker_invocations_used": {
      "type": "integer",
      "minimum": 0
    },
    "campaign_worker_timeout_ceiling_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "current_material_finding_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "repeated_material_finding_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "automated_remediation_retry_allowed": {
      "type": "boolean"
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SAME_MATERIAL_FINDING_REPEAT",
        "AUTOMATED_ATTEMPT_LIMIT",
        "NO_MATERIAL_FINDINGS",
        null
      ]
    },
    "budget_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reused_agent_stages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  }
}
