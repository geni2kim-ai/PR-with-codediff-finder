{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maestro:textdiff-evidence:2.4",
  "title": "TextDiff Evidence v2.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "binding",
    "summary",
    "files",
    "performance",
    "invariants",
    "trust",
    "semantic_digest",
    "output_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "product_version",
        "harness_api_version",
        "package_sha256",
        "checker_sha256",
        "syntax_db_sha256",
        "dependencies_sha256",
        "config_sha256",
        "regex_timeout_available",
        "harness_dependencies_sha256",
        "runtime_dependencies"
      ],
      "properties": {
        "name": {
          "const": "TextDiffChecker"
        },
        "product_version": {
          "type": "string"
        },
        "harness_api_version": {
          "type": "string"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "checker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "syntax_db_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "dependencies_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "regex_timeout_available": {
          "type": "boolean"
        },
        "harness_dependencies_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "runtime_dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_ref_sha",
        "base_sha",
        "head_sha",
        "comparison_mode"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "work_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "base_ref_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "comparison_mode": {
          "const": "merge-base"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_changed",
        "a_lines",
        "b_lines",
        "hunk_count",
        "changed_lines",
        "quality_class",
        "protected_candidates",
        "weakening_signals",
        "nontext_sensitive_paths"
      ],
      "properties": {
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "a_lines": {
          "type": "integer",
          "minimum": 0
        },
        "b_lines": {
          "type": "integer",
          "minimum": 0
        },
        "hunk_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "quality_class": {
          "enum": [
            "PROVEN_EXACT",
            "HEURISTIC",
            "APPROXIMATE",
            "NOT_APPLICABLE"
          ]
        },
        "protected_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "weakening_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "nontext_sensitive_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "change_type",
          "base_blob_sha",
          "head_blob_sha",
          "mode_before",
          "mode_after",
          "symlink",
          "submodule",
          "binary",
          "generated",
          "vendor",
          "language",
          "encoding",
          "status",
          "lines",
          "diff",
          "weakening_signals"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "old_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "change_type": {
            "enum": [
              "ADDED",
              "DELETED",
              "MODIFIED",
              "RENAMED",
              "COPIED",
              "TYPE_CHANGED",
              "UNMERGED",
              "UNKNOWN"
            ]
          },
          "base_blob_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{40,64}$"
          },
          "head_blob_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{40,64}$"
          },
          "mode_before": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode_after": {
            "type": [
              "string",
              "null"
            ]
          },
          "symlink": {
            "type": "boolean"
          },
          "submodule": {
            "type": "boolean"
          },
          "binary": {
            "type": "boolean"
          },
          "generated": {
            "type": "boolean"
          },
          "vendor": {
            "type": "boolean"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "encoding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base",
              "head",
              "confidence",
              "lossless_fallback_used"
            ],
            "properties": {
              "base": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "head": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "UNKNOWN"
                ]
              },
              "lossless_fallback_used": {
                "type": "boolean"
              }
            }
          },
          "status": {
            "enum": [
              "ANALYZED",
              "SKIPPED",
              "BINARY",
              "ERROR",
              "TIMEOUT"
            ]
          },
          "skip_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "lines": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b"
            ],
            "properties": {
              "a": {
                "type": "integer",
                "minimum": 0
              },
              "b": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "diff": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hunk_count",
              "changed_lines",
              "approx",
              "quality_class",
              "algorithm_path",
              "trace_digest"
            ],
            "properties": {
              "hunk_count": {
                "type": "integer",
                "minimum": 0
              },
              "changed_lines": {
                "type": "integer",
                "minimum": 0
              },
              "approx": {
                "type": "boolean"
              },
              "quality_class": {
                "enum": [
                  "PROVEN_EXACT",
                  "HEURISTIC",
                  "APPROXIMATE",
                  "NOT_APPLICABLE"
                ]
              },
              "algorithm_path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trace_digest": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          },
          "weakening_signals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "evidence": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_ms",
        "timed_out",
        "cancelled"
      ],
      "properties": {
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "peak_memory_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "timed_out": {
          "type": "boolean"
        },
        "cancelled": {
          "type": "boolean"
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unknown",
              "not_required"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_safety",
        "trusted_for_gate",
        "reasons"
      ],
      "properties": {
        "runtime_safety": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "trusted_for_gate": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "output_digest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
