{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maestro:standard-candidate:2.4",
  "title": "Standard Update Candidate v2.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "source_case_id",
    "status",
    "rule",
    "detection",
    "severity",
    "evidence_refs",
    "approval",
    "candidate_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "candidate_id": {
      "type": "string"
    },
    "source_case_id": {
      "type": "string"
    },
    "status": {
      "const": "PROPOSED"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "text",
        "rationale",
        "good_example_ref",
        "bad_example_ref",
        "expires_on"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "good_example_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "bad_example_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_on": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "machine_enforceable"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "machine_enforceable": {
          "type": "boolean"
        }
      }
    },
    "severity": {
      "enum": [
        "blocker",
        "major",
        "minor",
        "nit"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "approved"
      ],
      "properties": {
        "required": {
          "const": [
            "HUMAN",
            "CODEOWNER"
          ]
        },
        "approved": {
          "const": false
        }
      }
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
